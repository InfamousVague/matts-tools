<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pill" android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="14dp" android:background="@drawable/pill_bg">
    <ImageView android:id="@+id/icon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_frames" android:tint="#F5F5F5" />
    <TextView android:id="@+id/words" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
        android:text="Not measuring" android:textColor="#B3F5F5F5" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1" />
</LinearLayout>
