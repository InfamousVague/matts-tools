<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pill" android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="14dp"
    android:background="@drawable/pill_bg">
    <ImageView android:id="@+id/icon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_pill" android:tint="#F5F5F5" />
    <Chronometer android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:textColor="#0D0D0D" android:textSize="16sp" android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="tnum" android:visibility="gone" />
    <TextView android:id="@+id/off" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:text="Asleep" android:textColor="#B3F5F5F5" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
</LinearLayout>
